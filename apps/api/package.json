{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:server": "php artisan serve",
    "dev:worker": "php artisan queue:work --tries=3 --backoff=30 --sleep=3 --queue=default",
    "dev:predict": "cd ..\\..\\services\\predict && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8001",
    "lint": "php vendor/bin/pint --test",
    "format": "php vendor/bin/pint"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  }
}
